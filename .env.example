# Copy to .env and adjust. bootstrap.sh does this for you interactively.

# Base domain for all services. Services are exposed as subdomains:
#   traefik.${DOMAIN}, auth.${DOMAIN}, grafana.${DOMAIN}, prometheus.${DOMAIN}
# You need DNS records (A/CNAME or a wildcard *.${DOMAIN}) pointing at this host.
DOMAIN=home.example.com

# Email used for Let's Encrypt registration and expiry notices.
ACME_EMAIL=admin@example.com

# Timezone for all containers (affects logs and Grafana display).
TZ=Etc/UTC

# Traefik log level: DEBUG, INFO, WARN, ERROR
TRAEFIK_LOG_LEVEL=INFO

# Prometheus metric retention
PROMETHEUS_RETENTION=30d

# Optional services (Compose profiles), comma-separated.
# Available: portainer, adguard, ntfy, homepage
#COMPOSE_PROFILES=portainer,homepage

# --- Kiosk display ---
# Host allowed to open Grafana without authenticating, for a wall display that
# should never show a login prompt. CIDR notation, one host: 192.168.1.50/32.
# It gets Grafana's anonymous Viewer role — read-only, no editing, no admin.
# Leave unset and nothing is bypassed; every client goes through Authelia.
#KIOSK_IP=192.168.200.10/32

# --- Backups (scripts/backup.sh) ---
# Local backup target and how many timestamped backups to keep.
#BACKUP_DIR=./backups
#BACKUP_KEEP=7
# Offsite via restic: if RESTIC_REPOSITORY is set and restic is installed,
# backup.sh pushes snapshots there instead of keeping local copies.
#RESTIC_REPOSITORY=sftp:user@nas:/backups/homelab
#RESTIC_PASSWORD_FILE=/root/.restic-password
