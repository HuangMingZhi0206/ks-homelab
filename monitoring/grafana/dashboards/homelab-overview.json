{
  "title": "Homelab Overview",
  "uid": "homelab-overview",
  "schemaVersion": 39,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Host CPU Usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU busy"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Host Memory Usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "Memory used"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Traefik Requests / s (by service)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(traefik_service_requests_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Container CPU (by container)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) * 100",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Host Disk Usage (/)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"})) * 100",
          "legendFormat": "/ used"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Authelia Auth Attempts / s",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (success) (rate(authelia_authentication_first_factor_total[5m]))",
          "legendFormat": "success={{success}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Bedroom Temperature & Humidity (DHT11)",
      "description": "From the Arduino in the bedroom, via roomhub/hub_kamar.py and the node-exporter textfile collector. The line breaks when the sensor fails to read, on purpose: 0 °C is more misleading than a gap.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "celsius" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Humidity" },
            "properties": [
              { "id": "unit", "value": "humidity" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "targets": [
        { "refId": "A", "expr": "roomhub_room_temperature_celsius", "legendFormat": "Temperature" },
        { "refId": "B", "expr": "roomhub_room_humidity_percent", "legendFormat": "Humidity" }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Bedroom AC — as the Arduino believes it",
      "description": "Not the state of the AC itself. IR is one way, so this is the last thing commanded from the panel. Use the original remote and these values stay behind until the next command from here.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "celsius" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Power" },
            "properties": [
              { "id": "unit", "value": "short" },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "OFF", "color": "text" }, "1": { "text": "ON", "color": "green" } } }
                ]
              }
            ]
          }
        ]
      },
      "options": { "textMode": "value_and_name", "colorMode": "value", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "roomhub_ac_power", "instant": true, "legendFormat": "Power" },
        { "refId": "B", "expr": "roomhub_ac_target_celsius", "instant": true, "legendFormat": "Setpoint" }
      ]
    }
  ]
}
