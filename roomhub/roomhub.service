[Unit]
Description=Room hub — LCD keypad panel on the Arduino
# The board is on a USB cable, so it may not exist at boot and may vanish
# later. The daemon handles both itself; this only avoids a pointless failure
# in the first seconds after boot.
After=network.target

[Service]
Type=simple
User=ubuntu
ExecStart=/usr/bin/python3 /opt/homelab/roomhub/hub_kamar.py
Restart=always
RestartSec=5

# Nothing here needs to write outside its own logs.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
