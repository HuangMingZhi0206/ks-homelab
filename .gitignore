# Environment & secrets — never commit these
.env
secrets/
authelia/users_database.yml

# Runtime state
traefik/acme/
traefik/certs/
authelia/db.sqlite3
authelia/notification.txt
backups/
homepage/config/logs/

# Editor swap files. vim's swap file holds fragments of whatever was being
# edited — for users_database.yml that means password hashes — and this repo is
# public. nano leaves a metadata-only .swp lock file instead; ignored too.
*.swp
*.swo

# Downloaded by scripts/fetch-tessdata.sh, not committed
stirling/ind.traineddata

# OS noise
.DS_Store
Thumbs.db
traefik/traefik.yml

# Home Assistant runtime state (config YAML itself stays tracked)
homeassistant/config/.storage/
homeassistant/config/.cloud/
homeassistant/config/deps/
homeassistant/config/tts/
homeassistant/config/backups/
homeassistant/config/blueprints/
homeassistant/config/custom_components/
homeassistant/config/*.db
homeassistant/config/*.db-*
homeassistant/config/*.log
homeassistant/config/*.log.*
homeassistant/config/.HA_VERSION
homeassistant/config/.uuid

# Rendered by bootstrap.sh from contact-points.yaml.tmpl; carries the bot token
monitoring/grafana/provisioning/alerting/contact-points.yaml
