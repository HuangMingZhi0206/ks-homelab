# Copy to .env and adjust. bootstrap.sh does this for you interactively.

# Base domain for all services. Services are exposed as subdomains:
#   traefik.${DOMAIN}, auth.${DOMAIN}, grafana.${DOMAIN}, prometheus.${DOMAIN}
# You need DNS records (A/CNAME or a wildcard *.${DOMAIN}) pointing at this host.
DOMAIN=home.example.com

# Email used for Let's Encrypt registration and expiry notices.
ACME_EMAIL=admin@example.com

# Timezone for all containers (affects logs and Grafana display).
TZ=Etc/UTC

# Traefik log level: DEBUG, INFO, WARN, ERROR
TRAEFIK_LOG_LEVEL=INFO

# Prometheus metric retention
PROMETHEUS_RETENTION=30d
