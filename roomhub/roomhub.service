[Unit]
Description=Room hub — Arduino panel on USB serial
# The board is on a USB cable, so it may not exist at boot and may vanish
# later. The daemon handles both itself; this only avoids a pointless failure
# in the first seconds after boot.
After=network.target

[Service]
Type=simple
User=ubuntu
# Reading and writing the serial port needs this group; see README.
SupplementaryGroups=dialout
ExecStart=/usr/bin/python3 /opt/homelab/roomhub/hub_kamar.py
Restart=always
RestartSec=5

# Creates /var/lib/roomhub owned by this user and, unlike RuntimeDirectory,
# keeps it across restarts. Home Assistant bind-mounts this directory to write
# commands, and a bind mount survives a restart only if the directory does:
# delete and recreate it and the container keeps writing into the old inode.
StateDirectory=roomhub
# 0770 rather than 0750: the group is what lets another service write commands
# without being root.
StateDirectoryMode=0770

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# ProtectSystem=strict makes everything read-only, including /opt. The metrics
# file is the one thing this daemon writes outside its own logs.
ReadWritePaths=/opt/homelab/monitoring/textfile

[Install]
WantedBy=multi-user.target
