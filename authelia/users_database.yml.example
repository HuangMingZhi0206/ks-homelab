# Example user database. bootstrap.sh generates the real users_database.yml
# (gitignored) with a properly hashed password.
#
# To hash a password manually:
#   docker run --rm authelia/authelia:4.39 authelia crypto hash generate argon2 --password 'yourpassword'

users:
  admin:
    disabled: false
    displayname: "Admin"
    password: "$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME"
    email: admin@example.com
    groups:
      - admins
